# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://username:password@host:port/database

# Server Port
PORT=5000

# JWT Secret for Admin/User Authentication
JWT_SECRET=your_jwt_secret_here

# Default admin account created by the seed script
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_here

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Stripe Keys (for payment)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Email SMTP (optional, if using nodemailer)
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_password_here

# Machine Learning Service URL
ML_SERVICE_URL=https://machine-learning-mode-for-churn.onrender.com

# SendGrid (for email notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=your_verified_sender_email_here

# External APIs
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_LOCATIONIQ_KEY=your_locationiq_key_here

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
